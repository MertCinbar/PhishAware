# ===================================================================
# PhishAware - Çevre Değişkenleri Şablonu (.env.example)
# Gerçek değerleriniz için bu dosyayı kopyalayıp '.env' olarak kaydedin.
# ===================================================================

# Google Gemini API Anahtarı (Yapay zeka ile dinamik oltalama senaryoları üretimi için)
# https://aistudio.google.com/ adresinden temin edebilirsiniz.
# Boş bırakılırsa sistem yerel zengin kurumsal şablon havuzunu kullanır.
GEMINI_API_KEY=your_gemini_api_key_here

# Canlı E-posta Gönderimi için Kurumsal SMTP Ayarları (İsteğe Bağlı)
# Boş bırakılırsa canlı testler güvenli "Simülasyon Kuyruğu" modunda çalışır.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
